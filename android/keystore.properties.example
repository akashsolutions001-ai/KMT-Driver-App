# Production Keystore Configuration Template
# Copy this file to keystore.properties in the same directory (android/)
# and fill in your actual production keystore password.
# DO NOT commit keystore.properties or your .keystore file to source control.

storeFile=../../kmt-release.keystore
storePassword=<REAL_KEYSTORE_PASSWORD>
keyAlias=kmt-key
keyPassword=<REAL_KEY_PASSWORD>
